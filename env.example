# Copy this file to .env for local development. Values below are examples,
# not production credentials. Use unique secrets outside local development.
POSTGRES_DB=telemed
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@telemed.dev
PGADMIN_DEFAULT_PASSWORD=change-me-local-only
PGADMIN_PORT=8080

# Optional Spring Boot API profile
TELEMED_API_DB_USER=telemed_api
TELEMED_API_DB_PASSWORD=change-me-local-only
DB_POOL_SIZE=10
API_PORT=8081
